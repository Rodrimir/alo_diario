# =============================================================================
# Copie para .env (NÃO versionado):  cp .env.example .env
# O .env é lido pelo docker compose (interpolação) e pela aplicação
# (spring.config.import=optional:file:.env[.properties]).
# Os valores abaixo são credenciais LOCAIS de desenvolvimento, não segredos reais.
# Em produção, defina tudo via variáveis de ambiente / secret manager.
# =============================================================================

# --- Aplicação -----------------------------------------------------------------
# Perfil: dev (padrão, mocks) | prod. Defina como variável de ambiente do shell/container;
# o Spring não ativa perfis a partir deste arquivo.
# SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- PostgreSQL ----------------------------------------------------------------
DB_NAME=cuida
DB_USERNAME=cuida
DB_PASSWORD=cuida
DB_PORT=5432
# Opcional: sobrescreve a URL montada a partir das variáveis acima.
# DB_URL=jdbc:postgresql://localhost:5432/cuida
DB_POOL_SIZE=10

# --- Armazenamento S3 (MinIO local) --------------------------------------------
MINIO_ROOT_USER=cuida
MINIO_ROOT_PASSWORD=cuida-dev-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=cuida-recordings
S3_REGION=us-east-1
# Endpoint que a aplicação usa para falar com o S3.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=cuida
S3_SECRET_KEY=cuida-dev-password
S3_PATH_STYLE=true
# s3 (MinIO/AWS) | filesystem (grava em APP_STORAGE_DIRECTORY, sem MinIO)
APP_STORAGE_PROVIDER=s3
APP_STORAGE_DIRECTORY=./data/recordings
# Hosts de onde a gravação do provedor pode ser baixada (proteção contra SSRF).
APP_RECORDING_ALLOWED_HOSTS=storage.vapi.ai,*.vapi.ai

# --- Segurança ------------------------------------------------------------------------
# Segredo HS256 com pelo menos 32 bytes. Gere com: openssl rand -base64 48
# No perfil dev, se vazio, um segredo aleatório é gerado a cada inicialização.
JWT_SECRET=
JWT_TTL=PT1H
# Administrador criado na inicialização (opcional; no dev há um admin semeado).
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Origens do frontend autorizadas (CORS), separadas por vírgula. Vazio = nenhuma (no dev: localhost).
APP_CORS_ALLOWED_ORIGINS=

# --- Jobs e ligações --------------------------------------------------------------
# false desliga todos os jobs (agendador, retentativas, varreduras, retenção).
APP_JOBS_ENABLED=true
APP_CALLS_RECOVERY_WINDOW=PT2H
APP_CALLS_STUCK_AFTER=PT30M
APP_CALLS_MAX_DURATION_SECONDS=600
APP_PRODUCT_NAME=Alô Diário
# Threads do pipeline pós-ligação (download, transcrição, resumo).
APP_PIPELINE_THREADS=4

# --- IA / OpenAI ---------------------------------------------------------------------
# mock (padrão, sem chave) | openai (exige OPENAI_API_KEY)
APP_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# PROVIDER = usa a transcrição do gateway de voz; WHISPER = transcreve com a OpenAI.
APP_TRANSCRIPTION_MODE=PROVIDER

# --- Gateway de voz ------------------------------------------------------------------
# mock (padrão: simula a ligação e os webhooks) | vapi (liga de verdade)
APP_VOICE_PROVIDER=mock
APP_VOICE_MOCK_DELAY=PT3S
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Segredo enviado pelo Vapi no header do webhook (server.headers do assistente).
VAPI_WEBHOOK_SECRET=
# URL pública do backend para o Vapi chamar (ex.: túnel ngrok/cloudflared em dev).
VAPI_WEBHOOK_BASE_URL=
# Assistente transitório (ajustar com testes reais com idosos).
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o
VAPI_VOICE_PROVIDER=azure
VAPI_VOICE_ID=pt-BR-FranciscaNeural
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-2
VAPI_TRANSCRIBER_LANGUAGE=pt-BR

# --- Avisos à família pelo WhatsApp (whats-api da equipe) ---------------------------
# mock (padrão: só registra no log) | whatsapi
NOTIFICATIONS_PROVIDER=mock
WHATSAPI_BASE_URL=
# api_key da empresa no whats-api (empresas.api_key)
WHATSAPI_API_KEY=
WHATSAPI_TEMPLATE_RESUMO=alo_diario_resumo
WHATSAPI_TEMPLATE_SEM_CONTATO=alo_diario_sem_contato
WHATSAPI_TEMPLATE_ALERTA=alo_diario_alerta

# --- LGPD: retenção -------------------------------------------------------------------
APP_RETENTION_AUDIO_DAYS=90
APP_RETENTION_WEBHOOK_PAYLOAD_DAYS=7
