root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# google-java-format (2 espaços) é aplicado pelo Spotless: ./mvnw spotless:apply
[*.java]
indent_size = 2
max_line_length = 100

[{pom.xml,*.xml}]
indent_size = 4

[*.sql]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
