# Normaliza fim de linha para LF no repositório.
* text=auto eol=lf

# Scripts Unix precisam de LF mesmo no Windows; scripts Windows usam CRLF.
mvnw      text eol=lf
*.sh      text eol=lf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binários
*.jar     binary
*.mp3     binary
*.wav     binary
*.png     binary
*.jpg     binary
*.gif     binary
*.pdf     binary
